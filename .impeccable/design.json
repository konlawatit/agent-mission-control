  "narrative": {
    "northStar": "The Glass Control Room",
    "overview": "The dashboard sits beside the terminals and says what every Claude Code room is doing right now, without opening it. Its world was pinned by the author with a reference image: a soft lavender room, a violet gradient shell, and a large sheet of rounded white glass. Violet means \"act here or this is selected\"; four status hues mean exactly one thing each. The room card, not the log, is the unit of the product.",
    "keyCharacteristics": [
      "Lavender ground (hue 282) with a pink and a violet blurred field; a violet-to-periwinkle gradient shell.",
      "One large translucent glass work card (26px radius, 28px blur, violet-tinted shadow) holding list, room and inspector.",
      "Rich room cards (18px radius) that summarise each room; the open one slides toward the room it opens.",
      "One violet primary for acting and selection, drawn as a gradient on buttons, send and user chat bubbles.",
      "Four status hues with fixed meanings: amber needs you, blue working, green done, rose quota hold.",
      "An authored line-icon set (24 grid, 1.75 stroke, round caps) in currentColor; no emoji.",
      "Light and dark follow the system and can be pinned; dark is deep indigo glass with the same structure."
    ],
    "rules": [
      {
        "name": "The Meaning-Only Rule",
        "section": "colors",
        "body": "Status hues carry meaning only: amber needs you, blue working, green done or a diff addition, rose quota hold or a diff deletion. Never decoration, category or emphasis."
      },
      {
        "name": "The One Violet Rule",
        "section": "colors",
        "body": "Violet is the only colour that says \"you can act here\" or \"this is selected\". It never stands in for a status."
      },
      {
        "name": "The Rising Meter Rule",
        "section": "colors",
        "body": "Meters fill violet at rest (white in the shell) and shift to amber, then rose, near a limit: usage below 25% and below the hold threshold; context above 60% and 85%. A 0% meter draws no fill."
      },
      {
        "name": "The Neutral Modification Rule",
        "section": "colors",
        "body": "The M file badge is neutral; only A/U take green and D takes rose."
      },
      {
        "name": "The Measured Contrast Rule",
        "section": "colors",
        "body": "Contrast is measured over composited glass in both themes. Text clears 4.5:1; white text sits only on primary or hold-fill; the shell gradient was deepened until its labels pass."
      },
      {
        "name": "The Mono-for-Machine Rule",
        "section": "typography",
        "body": "Mono marks machine text (code, paths, branches, tools, keys, diff counts); human numbers stay in Figtree with tabular figures."
      },
      {
        "name": "The No-Ligature Rule",
        "section": "typography",
        "body": "Code, keys and mono text render without ligatures so a diff shows exactly what was typed."
      },
      {
        "name": "The Sentence-Case Label Rule",
        "section": "typography",
        "body": "Labels are sentence case, set apart by weight and text-3, never uppercase or tracking."
      },
      {
        "name": "The Pinned Composer Rule",
        "section": "layout",
        "body": "The composer never moves and nothing paints under it; when content does not fit, the room column scrolls and the output keeps a 260px floor."
      },
      {
        "name": "The Blur-Free Ancestor Rule",
        "section": "layout",
        "body": "No ancestor of a position: fixed element carries backdrop-filter, filter or transform; on phones the work card drops its blur so the strip and sheets stay fixed to the screen."
      },
      {
        "name": "The Tinted Shadow Rule",
        "section": "elevation",
        "body": "Shadows carry the violet of the room (indigo in dark); glass gets a 1px inner white edge instead of a border."
      }
    ],
    "dos": [
      "**Do** let the room card answer \"what is it doing?\": status pill, stage, active tool, a short summary, the question when it asks.",
      "**Do** keep status hues to their single meanings and violet to acting and selection.",
      "**Do** measure contrast over the composited glass, in both themes, before shipping a colour.",
      "**Do** keep the composer pinned and let the column scroll when content does not fit.",
      "**Do** keep the M file badge neutral; only A/U go green and D goes rose.",
      "**Do** show approval keycaps only on the prompt card.",
      "**Do** open panels only on click, and never restore an open panel on reload.",
      "**Do** tint shadows violet (indigo in dark) and give glass a 1px inner white edge instead of a border.",
      "**Do** set numbers in tabular figures and machine text in mono without ligatures."
    ],
    "donts": [
      "**Don't** use emoji as icons, anywhere, including status, buttons and toasts.",
      "**Don't** put white text on hold, attn or the light shell stops; use hold-fill, dark ink, or the deepened gradient.",
      "**Don't** put backdrop-filter, filter or transform on an ancestor of a fixed element.",
      "**Don't** move the open room's card with margins; a transform keeps its text from re-wrapping and stays inside the list's scroll clip.",
      "**Don't** uppercase or letter-space labels; separate them with weight and text-3.",
      "**Don't** repeat the same pending prompt in more than one place on the screen."
    ]
  }
}
